// =====================================================================
// SHIROSE NIHONGO — Firestore Security Rules (example)
// =====================================================================
// SALIN rules ini ke Firebase Console → Firestore → Rules, lalu Publish.
// File ini disertakan di repo sebagai referensi; file ini sendiri tidak
// di-deploy otomatis oleh GitHub Pages (perlu `firebase deploy` jika mau).
//
// Tujuan:
//   - Siapa yang boleh baca/tulis apa.
//   - Backend enforcement untuk JLPT per-student access (Part 3).
//   - Guru TIDAK otomatis punya developer privileges (Part 6).
// =====================================================================

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function isSignedIn()      { return request.auth != null; }
    function uid()             { return request.auth.uid; }
    function siswa(uidX)       { return get(/databases/$(database)/documents/siswa/$(uidX)).data; }
    // Bootstrap: when a brand-new signup happens, the siswa doc doesn't exist
    // yet, so siswa(uid()).role would fail — we recognize "owner" emails here
    // so the first sign-in from the guru/dev email can read/write and set its
    // own role. Edit this list to match your own hardcoded GURU_EMAIL /
    // DEVELOPER_EMAIL in js/firebase-sync.js.
    function ownerEmails()     { return ["randitsmuhamad50@gmail.com"]; }
    function isOwnerEmail()    { return isSignedIn() && request.auth.token.email in ownerEmails(); }
    function roleOrBlank(uidX) {
      return exists(/databases/$(database)/documents/siswa/$(uidX))
             ? siswa(uidX).role : "";
    }
    function isGuru()          { return isSignedIn() && (roleOrBlank(uid()) == "guru"      || isOwnerEmail()); }
    function isDeveloper()     { return isSignedIn() && (roleOrBlank(uid()) == "developer" || isOwnerEmail()); }
    function isAdmin()         { return isSignedIn() && (roleOrBlank(uid()) == "admin"     || isOwnerEmail()); }
    function hasLevelAccess(l) { return isSignedIn() && (siswa(uid()).aksesLevel[l] == true); }

    // ---------- /siswa/{uid} ----------
    match /siswa/{sid} {
      // Student bisa baca dokumennya sendiri; guru bisa baca semua.
      allow read: if isSignedIn() && (uid() == sid || isGuru() || isAdmin() || isDeveloper());

      // Create: hanya saat sign-up untuk diri sendiri. role hanya boleh di-set
      // oleh owner email (bootstrap pertama kali) atau tidak di-set sama sekali.
      allow create: if isSignedIn() && uid() == sid
                    && (
                         !("role" in request.resource.data)
                         || (isOwnerEmail() && request.resource.data.role in ["guru","developer","admin"])
                       )
                    && (!("aksesLevel" in request.resource.data) || request.resource.data.aksesLevel.n5 == true);

      // Update: siswa bisa update profil ringan (nama, karakter), TAPI tidak boleh
      // mengubah role atau aksesLevel-nya sendiri. Guru/admin/owner bisa update role & aksesLevel siswa.
      allow update: if isSignedIn() && (
        (uid() == sid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role","aksesLevel"]))
        || isGuru() || isAdmin() || isDeveloper()
        // Owner email can always upgrade its own role (bootstrap recovery).
        || (uid() == sid && isOwnerEmail())
      );

      allow delete: if isAdmin() || isDeveloper();

      // Subcollections: student owns them.
      match /{sub}/{docId} {
        allow read, write: if uid() == sid || isGuru() || isAdmin() || isDeveloper();
      }
    }

    // ---------- /kategori_ujian ----------
    // Nov 2026: akses JLPT dibuka penuh buat semua akun. Rule hasLevelAccess
    // dihapus — asalkan signed in (termasuk tamu / anonymous), bisa baca
    // paket soal yang publish. Guru tetap pegang CRUD.
    match /kategori_ujian/{id} {
      allow read: if isSignedIn();
      allow create, update, delete: if isGuru() || isAdmin() || isDeveloper();
    }

    // ---------- /soal/{kategoriId}/items/{soalId} ----------
    match /soal/{kategoriId}/items/{soalId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isGuru() || isAdmin() || isDeveloper();
    }

    // ---------- /item_shop/{kategori}/items/{id} ----------
    match /item_shop/{kat}/items/{id} {
      allow read: if isSignedIn();
      allow write: if isGuru() || isAdmin() || isDeveloper();
    }

    // ---------- /komentar/{compositeKey}/items/{id} ----------
    // compositeKey = "<tipe>_<lvl>_<no>" e.g. "kanji_n3_12"
    match /komentar/{key}/items/{id} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == uid()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 1000;
      // Owner can delete their own; guru/admin can moderate any.
      allow delete: if isSignedIn() && (
        resource.data.uid == uid() || isGuru() || isAdmin() || isDeveloper()
      );
      // No edits for now — keep comments immutable so discussion history stays honest.
      allow update: if false;
    }

    // ---------- /misi_global, /achievements_catalog, dsb ----------
    match /{coll}/{doc=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isDeveloper();
    }
  }
}

// =====================================================================
// CATATAN role & permissions
// =====================================================================
// siswa.role ∈ { "student" (default), "guru", "admin", "developer" }
// siswa.permissions.unlimited_coins (bool) — khusus developer, bisa diberikan
//   ke akun lain hanya dengan write dari developer sendiri (bukan di sini,
//   tetapi di Cloud Function atau manual Admin SDK, untuk server-side auth).
// =====================================================================
