// =====================================================================
// SHIROSE NIHONGO — Firestore Security Rules (yang di-PUBLISH di Console)
// Firebase Console → Firestore → Rules → paste → Publish.
// =====================================================================
// Model akun (satu sistem: Firebase Auth project "shirose-nihongo"):
//   - Moderator  : email di ownerEmail() — akses penuh, bootstrap profil sendiri.
//   - Admin/Guru : siswa/{uid}.role = "admin" | "developer" | "guru".
//   - Siswa      : siswa/{uid}.role = "student" (default).
//   - Akun Auth TANPA profil siswa/{uid} = BELUM TERDAFTAR → tidak bisa baca
//     data apa pun. Profil hanya dibuat guru/moderator (pendaftaran ditutup).
//   - siswa/{uid}.status = "nonaktif" → semua akses ditolak.
//   - siswa/{uid}.aksesLevel.{n5..n1} = true → boleh baca soal & choukai
//     level tersebut. Siswa TIDAK bisa mengubah role/akses/status sendiri.
// =====================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn()   { return request.auth != null; }
    function me()         { return request.auth.uid; }
    function ownerEmail() { return signedIn() && request.auth.token.email == "randitsmuhamad50@gmail.com"; }
    function profilPath(u){ return /databases/$(database)/documents/siswa/$(u); }
    function adaProfil()  { return signedIn() && exists(profilPath(me())); }
    function profil()     { return get(profilPath(me())).data; }
    function aktif()      { return adaProfil() && profil().get('status', 'aktif') != 'nonaktif'; }
    function role()       { return profil().get('role', 'student'); }
    function isAdmin()    { return ownerEmail() || (aktif() && role() in ['admin', 'developer']); }
    function isGuru()     { return isAdmin() || (aktif() && role() == 'guru'); }
    function terdaftar()  { return ownerEmail() || aktif(); }
    function bolehLevel(l){
      return isGuru() || (aktif() && profil().get('aksesLevel', {}).get(l, false) == true);
    }
    function diubah()     { return request.resource.data.diff(resource.data).affectedKeys(); }
    function targetSiswa(){ return resource.data.get('role', 'student') == 'student'; }

    // ---------- /siswa/{uid} : profil akun ----------
    match /siswa/{sid} {
      allow read: if signedIn() && (me() == sid || isGuru());

      // Hanya guru/moderator yang membuat profil (guru hanya role student),
      // atau moderator mem-bootstrap profilnya sendiri.
      allow create: if (isGuru() && request.resource.data.get('role', 'student') == 'student')
                    || (isAdmin() && request.resource.data.get('role', 'student') in ['student', 'guru'])
                    || (me() == sid && ownerEmail());

      allow update: if
          // Siswa: profil ringan saja (nama, karakter, aktif), tidak boleh ubah hak akses.
          (me() == sid && aktif()
             && !diubah().hasAny(['role', 'aksesLevel', 'aksesSsw', 'aksesSswBidang', 'kelas', 'status', 'email', 'permissions', 'dibuatOleh']))
          // Moderator boleh memperbaiki profilnya sendiri.
          || (me() == sid && ownerEmail())
          // Guru: atur akses/kelas/status/nama siswa (bukan role, bukan akun guru lain).
          || (isGuru() && targetSiswa() && !diubah().hasAny(['role', 'permissions']))
          // Admin/moderator: semua.
          || isAdmin();

      // Admin/moderator: semua. Guru: hanya akun siswa (role student).
      allow delete: if isAdmin() || (isGuru() && targetSiswa());

      // Sub-koleksi milik siswa: srs, gami, activity, nilai, misi_harian,
      // rangkuman, ujian_rewards, dll.
      match /{sub}/{docId} {
        allow read: if signedIn() && ((me() == sid && terdaftar()) || isGuru());
        allow write: if signedIn() && ((me() == sid && terdaftar()) || isGuru());
      }
    }

    // ---------- Ujian ----------
    // Daftar kategori boleh dilihat siswa terdaftar (UI menandai yang terkunci);
    // ISI SOAL hanya bisa dibaca bila level kategori dibuka untuk siswa itu.
    match /kategori_ujian/{id} {
      allow read: if terdaftar();
      allow write: if isGuru();
    }
    match /soal/{katId}/items/{soalId} {
      allow read: if isGuru()
        || bolehLevel(get(/databases/$(database)/documents/kategori_ujian/$(katId)).data.get('level', 'n5'));
      allow write: if isGuru();
    }
    match /choukai/{lvl}/items/{id} {
      allow read: if bolehLevel(lvl);
      allow write: if isGuru();
    }

    // ---------- SSW 特定技能 ----------
    // Konfigurasi bidang (aktif/nonaktif, status bab). Siswa terdaftar boleh membaca; hanya guru yang menulis.
    // Progres siswa ada di siswa/{uid}/ssw_progres/{slug} → sudah tercakup rule sub-koleksi di atas.
    match /ssw_bidang/{slug} {
      allow read: if terdaftar();
      allow write: if isGuru();
      allow delete: if isAdmin();
    }

    // Leaderboard SSW: siswa terdaftar membaca; tiap siswa hanya menulis dokumennya sendiri.
    match /ssw_rank/{rid} {
      allow read: if terdaftar();
      allow create, update: if signedIn() && aktif()
          && request.resource.data.uid == me()
          && rid == request.resource.data.slug + '__' + me()
          && request.resource.data.keys().hasOnly(['uid', 'slug', 'nama', 'kelas', 'poin', 'rinci', 'upd'])
          && request.resource.data.poin is number && request.resource.data.poin >= 0 && request.resource.data.poin <= 1000000;
      allow delete: if isGuru();
    }

    // ---------- Kelas kata kosakata (override guru) ----------
    match /kosakata_pos/{lvl} {
      allow read: if terdaftar();
      allow write: if isGuru();
    }

    // ---------- Lain-lain ----------
    match /kelas/{kid} {
      allow read: if terdaftar();
      allow write: if isGuru();
    }
    match /item_shop/{kat}/items/{id} {
      allow read: if terdaftar();
      allow write: if isGuru();
    }
    match /komentar/{key}/items/{id} {
      allow read: if terdaftar();
      allow create: if terdaftar()
                    && request.resource.data.uid == me()
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 1000;
      allow delete: if signedIn() && (resource.data.uid == me() || isGuru());
      allow update: if false;
    }
    // Sengaja TIDAK ada rule catch-all: koleksi yang tidak disebut di atas ditolak.
  }
}
